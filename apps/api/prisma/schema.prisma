model PartnershipDeliveryDeliverableSubmission {
  id            String                       @id @default(uuid()) @db.Uuid
  deliverableId String                       @db.Uuid
  deliverable   PartnershipDeliveryDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
