  contact       PartnershipContact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId        String?                 @db.Uuid
  lead          PartnershipLead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  activityType  PartnershipActivityType
  subject       String
  description   String                  @default("")
  activityDate  DateTime                @default(now())
  createdById   String                  @db.Uuid
