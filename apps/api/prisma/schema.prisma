// ---------------------------------------------------------------------------
// School Partnership Offerings
// ---------------------------------------------------------------------------
// An Offering is a school-facing packaging layer that sits ON TOP of an
// existing PartnershipProgram. It keeps a *live* link to its program
// (programId) so inherited catalog content always reflects the latest program
// edits. Offerings never duplicate program business content; instead they:
//   * override a small set of positioning fields (targetAge, targetGrades,
//     recommendedLevel, learnerProfile) when non-null;
//   * describe commercial/delivery logistics (duration, sessions, groups...);
//   * optionally narrow the inherited curriculum via selection join tables.
// Offerings intentionally carry NO pricing data â only an internal
// commercialNotes string. See offerings.service.ts for the read-time
// inheritance resolution rules.

enum PartnershipOfferingStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PartnershipDurationUnit {
  WEEKS
  MONTHS
  SEMESTER
  ANNUAL
}

enum PartnershipDeliveryMode {
  ON_SITE
  ONLINE
  HYBRID
}

