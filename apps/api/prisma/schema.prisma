  name         String
  checkpointDate DateTime?
  participants String                               @default("")
  discussion   String                               @default("")
  decisions    String                               @default("")
  actionItems  String                               @default("")
  status       PartnershipDeliveryCheckpointStatus  @default(PLANNED)
  sortOrder    Int                                  @default(0)

  @@index([deliveryId, sortOrder])
}

model PartnershipDeliveryReport {
  id            String                            @id @default(uuid()) @db.Uuid
  deliveryId    String                            @db.Uuid
  delivery      PartnershipDelivery               @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
