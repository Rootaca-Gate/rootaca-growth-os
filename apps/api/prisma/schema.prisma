enum PartnershipImportStatus {
  DRAFT
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum PartnershipImportRowDecision {
  PENDING
  SKIP
  MERGE
  IMPORT
  IMPORT_ANYWAY
}

enum PartnershipImportMatchConfidence {
  NONE
  POSSIBLE
  EXACT
}

enum PartnershipImportRowResult {
  PENDING
  IMPORTED
  MERGED
  SKIPPED
  FAILED
  INVALID
}

/// Staged CSV import job (preview → decisions → execute). File bytes are not retained.
model PartnershipImportJob {
  id            String                  @id @default(uuid()) @db.Uuid
  fileName      String
  fileSizeBytes Int
  uploadedById  String                  @db.Uuid
  uploadedBy    User                    @relation("PartnershipImportUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  status        PartnershipImportStatus @default(DRAFT)
  headersJson   Json
  mappingJson   Json
  summaryJson   Json?
  resultJson    Json?
  errorMessage  String?
  expiresAt     DateTime
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  completedAt   DateTime?
  rows          PartnershipImportRow[]

  @@index([uploadedById])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
}

model PartnershipImportRow {
  id                     String                            @id @default(uuid()) @db.Uuid
  jobId                  String                            @db.Uuid
  job                    PartnershipImportJob              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rowNumber              Int
  rawJson                Json
  mappedJson             Json?
  normalizedJson         Json?
  isValid                Boolean                           @default(false)
  validationErrorsJson   Json?
  matchConfidence        PartnershipImportMatchConfidence  @default(NONE)
  matchReasonsJson       Json?
  matchedInstitutionId   String?                           @db.Uuid
  matchedInstitutionName String?
  csvDuplicateOfRow      Int?
  decision               PartnershipImportRowDecision      @default(PENDING)
  resultStatus           PartnershipImportRowResult        @default(PENDING)
  resultError            String?
  resultInstitutionId    String?                           @db.Uuid

  @@unique([jobId, rowNumber])
  @@index([jobId])
  @@index([decision])
  @@index([matchConfidence])
  @@index([isValid])
  @@index([resultStatus])
}

enum PartnershipResearchJobStatus {
  DRAFT
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum PartnershipResearchStatus {
  DISCOVERED
  ENRICHING
  READY_FOR_REVIEW
  VERIFIED
  REJECTED
  DUPLICATE
  IMPORTED
  STALE
}

enum PartnershipResearchVerificationStatus {
  UNVERIFIED
  PARTIALLY_VERIFIED
  VERIFIED
  STALE
}

enum PartnershipResearchDuplicateStatus {
  NEW
  EXACT_MATCH
  POSSIBLE_MATCH
  REVIEWED_DUPLICATE
}

enum PartnershipResearchSourceType {
  SEARCH_ENGINE
  OFFICIAL_WEBSITE
  PUBLIC_DIRECTORY
  PUBLIC_MAPS_LISTING
  PUBLIC_SOCIAL_PAGE
  GOVERNMENT_LISTING
  OSM
  MANUAL
  OTHER
}

enum PartnershipResearchLanguage {
  EN
  AR
  BOTH
}

enum PartnershipResearchDataQuality {
  LOW
  MEDIUM
  HIGH
}

/// Controlled research job (geography + templates). Automated web discovery requires a configured provider.
model PartnershipResearchJob {
  id                   String                        @id @default(uuid()) @db.Uuid
  name                 String
  governorate          String?
  city                 String?
  district             String?
  institutionType      PartnershipInstitutionType?
  institutionCategory  PartnershipInstitutionCategory?
  curriculum           PartnershipCurriculum?
  language             PartnershipResearchLanguage   @default(BOTH)
  technologyJson       Json                          @default("{}")
  queriesJson          Json                          @default("[]")
  maxResultsPerQuery   Int                           @default(20)
  maxQueries           Int                           @default(24)
  maxCandidates        Int                           @default(200)
  /// Discovery mode for this job: OVERPASS | WEB_SEARCH | HYBRID (null = env default)
  discoveryMode        String?
  status               PartnershipResearchJobStatus  @default(DRAFT)
  statisticsJson       Json?
  errorMessage         String?
  providerNote         String?
  requestedById        String                        @db.Uuid
  requestedBy          User                          @relation("PartnershipResearchRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  candidates           PartnershipResearchCandidate[]

  @@index([status])
  @@index([governorate])
  @@index([city])
  @@index([requestedById])
  @@index([createdAt])
}

model PartnershipResearchCandidate {
  id                       String                                 @id @default(uuid()) @db.Uuid
  jobId                    String?                                @db.Uuid
  job                      PartnershipResearchJob?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  discoveredName           String
  discoveredNameAr         String?
  discoveredNameEn         String?
  normalizedName           String?
  country                  String                                 @default("Egypt")
  governorate              String?
  city                     String?
  district                 String?
  address                  String?
  latitude                 Float?
  longitude                Float?
  osmType                  String?
  osmId                    String?
  osmUrl                   String?
  institutionType          PartnershipInstitutionType?
  institutionCategory      PartnershipInstitutionCategory?
  curriculum               PartnershipCurriculum?
  educationLevel           PartnershipEducationLevel?
  email                    String?
  phone                    String?
  mobile                   String?
  whatsapp                 String?
  normalizedPhone          String?
  website                  String?
  normalizedWebsiteDomain  String?
  facebook                 String?
  instagram                String?
  linkedin                 String?
  youtube                  String?
  tiktok                   String?
  googleMapsUrl            String?
  hasCoding                Boolean                                @default(false)
  hasRobotics              Boolean                                @default(false)
  hasStem                  Boolean                                @default(false)
  hasAi                    Boolean                                @default(false)
  hasTechClub              Boolean                                @default(false)
  hasAfterSchool           Boolean                                @default(false)
  hasSummerCamp            Boolean                                @default(false)
  hasMakerspace            Boolean                                @default(false)
  sourceType               PartnershipResearchSourceType          @default(MANUAL)
  sourceName               String?
  sourceUrl                String?
  discoveredAt             DateTime                               @default(now())
  lastCheckedAt            DateTime?
  researchStatus           PartnershipResearchStatus              @default(DISCOVERED)
  verificationStatus       PartnershipResearchVerificationStatus  @default(UNVERIFIED)
  dataQuality              PartnershipResearchDataQuality         @default(LOW)
  duplicateStatus          PartnershipResearchDuplicateStatus     @default(NEW)
  duplicateOfCandidateId   String?                                @db.Uuid
  duplicateOfCandidate     PartnershipResearchCandidate?          @relation("ResearchCandidateDuplicates", fields: [duplicateOfCandidateId], references: [id], onDelete: SetNull)
  duplicates               PartnershipResearchCandidate[]         @relation("ResearchCandidateDuplicates")
  matchedInstitutionId     String?                                @db.Uuid
  notes                    String                                 @default("")
  createdAt                DateTime                               @default(now())
  updatedAt                DateTime                               @updatedAt
  evidence                 PartnershipResearchEvidence[]

  @@index([jobId])
  @@index([researchStatus])
  @@index([verificationStatus])
  @@index([duplicateStatus])
  @@index([governorate])
  @@index([city])
  @@index([normalizedName])
  @@index([normalizedWebsiteDomain])
  @@index([normalizedPhone])
  @@index([discoveredAt])
  @@index([matchedInstitutionId])
  @@index([sourceType])
  @@index([osmId])
}

model PartnershipResearchEvidence {
  id            String                        @id @default(uuid()) @db.Uuid
  candidateId   String                        @db.Uuid
  candidate     PartnershipResearchCandidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  field         String
  value         String
  sourceUrl     String?
  sourceType    PartnershipResearchSourceType?
  discoveredAt  DateTime                      @default(now())
  confidence    PartnershipResearchDataQuality @default(MEDIUM)

  @@index([candidateId])
  @@index([field])
  @@index([discoveredAt])
}
