// ---------------------------------------------------------------------------
// PartnershipOffering
// ---------------------------------------------------------------------------
// Live-linked packaging on top of a PartnershipProgram. Nullable override
// fields resolve from the linked program at read time when null/empty.
// Deleting a program that still has offerings is blocked (onDelete: Restrict)
// to protect the live inheritance link.
model PartnershipOffering {
  id        String                    @id @default(uuid()) @db.Uuid
  name      String
  // Live link to the source program â always resolve the latest program row
  // for any inherited field. Restrict prevents deleting a program that still
  // has offerings hanging off it.
  programId String                    @db.Uuid
  program   PartnershipProgram        @relation(fields: [programId], references: [id], onDelete: Restrict)
  // Single delivery format this offering is packaged for (not a set like the
  // program supports); reuses the shared PartnershipDeliveryFormat enum.
  deliveryFormat PartnershipDeliveryFormat
  status         PartnershipOfferingStatus @default(DRAFT)

  // --- Override fields: when null/empty, resolve from the linked program ---
  targetAge        String?
  targetGrades     String?
  recommendedLevel PartnershipProgramLevel?
  learnerProfile   String?

  // --- Delivery / logistics (offering-only; no program equivalent) ---
  duration              Int?
  durationUnit          PartnershipDurationUnit?
  numberOfSessions      Int?
  sessionDurationMinutes Int?
  sessionFrequency      String?
  deliveryMode          PartnershipDeliveryMode?
  locationNotes         String                    @default("")
  groupSizeMin          Int?
  groupSizeMax          Int?
  numberOfGroups        Int?
  instructorRequirement String                    @default("")
  coordinatorRequirement String                   @default("")

  // --- Curriculum / project customization ---
  // Empty selection join tables => inherit ALL modules/projects from program.
  // includeFinalProject toggles whether the program final project is surfaced.
  curriculumCustomizationNotes String  @default("")
  projectCustomizationNotes    String  @default("")
  includeFinalProject          Boolean @default(true)

  // --- Assessment / reporting toggles ---
  assessmentFrequency      String  @default("")
  includeInitialAssessment Boolean @default(true)
  includeMidAssessment     Boolean @default(true)
  includeFinalAssessment   Boolean @default(true)
  studentProgressReport    Boolean @default(true)
  schoolSummaryReport      Boolean @default(true)

  // --- Internal / commercial (NO pricing â commercialNotes is a plain note) ---
  internalNotes   String @default("")
  commercialNotes String @default("")
  displayOrder    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  selectedModules  PartnershipOfferingSelectedModule[]
  selectedProjects PartnershipOfferingSelectedProject[]
  requirements     PartnershipOfferingRequirement[]
  proposalLines    PartnershipProposalOffering[]

  @@index([programId])
  @@index([status])
  @@index([deliveryFormat])
  @@index([displayOrder])
  @@index([name])
}

// Empty set for an offering => inherit ALL program curriculum modules.
// Non-empty => surface only the referenced modules (in sortOrder).
model PartnershipOfferingSelectedModule {
  id         String                             @id @default(uuid()) @db.Uuid
  offeringId String                             @db.Uuid
  offering   PartnershipOffering                @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  moduleId   String                             @db.Uuid
  module     PartnershipProgramCurriculumModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  sortOrder  Int                                @default(0)

  @@unique([offeringId, moduleId])
  @@index([offeringId, sortOrder])
  @@index([moduleId])
}

// Empty set for an offering => inherit ALL program sample projects.
// Non-empty => surface only the referenced sample projects (in sortOrder).
model PartnershipOfferingSelectedProject {
  id              String                          @id @default(uuid()) @db.Uuid
  offeringId      String                          @db.Uuid
  offering        PartnershipOffering             @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  sampleProjectId String                          @db.Uuid
  sampleProject   PartnershipProgramSampleProject @relation(fields: [sampleProjectId], references: [id], onDelete: Cascade)
  sortOrder       Int                             @default(0)

  @@unique([offeringId, sampleProjectId])
  @@index([offeringId, sortOrder])
  @@index([sampleProjectId])
}

// Custom requirement rows. If an offering has ANY requirement rows, those
// fully replace the inherited program requirements at read time; otherwise the
// program requirements are inherited. Mirrors PartnershipProgramRequirement.
model PartnershipOfferingRequirement {
  id          String                                @id @default(uuid()) @db.Uuid
  offeringId  String                                @db.Uuid
  offering    PartnershipOffering                   @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  kind        PartnershipProgramRequirementKind
  priority    PartnershipProgramRequirementPriority @default(REQUIRED)
  label       String
  description String                                @default("")
  sortOrder   Int                                   @default(0)

  @@index([offeringId, kind, sortOrder])
}

// ---------------------------------------------------------------------------
// PartnershipProposal
// ---------------------------------------------------------------------------
// School-specific commercial proposal layered on top of Offerings.
// Offerings remain live-linked for admin editing while DRAFT; at send time
// (and whenever a line is added) we freeze an immutable offering snapshot so
// later Program/Offering edits never mutate a sent proposal.
// Pricing lives ONLY here â never on Program or Offering.

enum PartnershipProposalStatus {
  DRAFT
  SENT
  VIEWED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  EXPIRED
  ARCHIVED
}

enum PartnershipPricingModel {
  PER_STUDENT
  PER_GROUP
  PER_SESSION
  PER_PROGRAM
  FIXED_PARTNERSHIP_FEE
  CUSTOM
}

enum PartnershipDiscountType {
  NONE
  PERCENTAGE
  FIXED_AMOUNT
}

model PartnershipProposal {
  id             String                    @id @default(uuid()) @db.Uuid
  proposalNumber String                    @unique
  title          String
  institutionId  String                    @db.Uuid
  institution    PartnershipInstitution    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  status         PartnershipProposalStatus @default(DRAFT)
  proposalDate   DateTime                  @default(now())
  validUntil     DateTime?
  preparedBy     String                    @default("")
  version        String                    @default("1.0")

  // Narrative / school-specific content
  executiveSummary         String @default("")
  schoolChallenge          String @default("")
  schoolObjective          String @default("")
  targetStudentGroup       String @default("")
  successCriteria          String @default("")
  partnershipObjective     String @default("")
  implementationApproach   String @default("")
  timelineNotes            String @default("")
  paymentTerms             String @default("")
  nextSteps                String @default("")
  termsAndConditions       String @default("")

  startDate DateTime?
  endDate   DateTime?

  // Commercial header â currency has NO default (must be set explicitly)
  currency            String?
  taxEnabled          Boolean                   @default(false)
  taxRate             Decimal?                  @db.Decimal(8, 4)
  headerDiscountType  PartnershipDiscountType   @default(NONE)
  headerDiscountValue Decimal?                  @db.Decimal(14, 4)

  // Persisted totals (authoritative after recalculation / send snapshot)
  subtotal       Decimal? @db.Decimal(14, 2)
  discountAmount Decimal? @db.Decimal(14, 2)
  taxAmount      Decimal? @db.Decimal(14, 2)
  grandTotal     Decimal? @db.Decimal(14, 2)

  // Share architecture (token ready; public portal can come later)
  shareToken          String?   @unique
  shareTokenCreatedAt DateTime?

  sentAt     DateTime?
  viewedAt   DateTime?
  // Locked once sent (or beyond) â edits require a new version / draft revision
  isLocked   Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offerings      PartnershipProposalOffering[]
  timelinePhases PartnershipProposalTimelinePhase[]
  customOutcomes PartnershipProposalOutcome[]
  versions       PartnershipProposalVersion[]
  sows           PartnershipSow[]
  deliveries     PartnershipDelivery[]
  partnershipReports PartnershipReport[]
  opportunitiesAsPrevious PartnershipOpportunity[] @relation("OpportunityPreviousProposal")
  opportunitiesAsNew      PartnershipOpportunity[] @relation("OpportunityNewProposal")

  @@index([institutionId])
  @@index([status])
  @@index([proposalDate])
  @@index([validUntil])
  @@index([createdAt])
  @@index([title])
}

/// Line item: live offering FK + frozen snapshot + proposal-only customization + pricing.
model PartnershipProposalOffering {
  id         String               @id @default(uuid()) @db.Uuid
  proposalId String               @db.Uuid
  proposal   PartnershipProposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  offeringId String               @db.Uuid
  offering   PartnershipOffering  @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  sortOrder  Int                  @default(0)

  // --- Frozen snapshot (authoritative for PDF / sent proposals) ---
  snapshotProgramName              String
  snapshotOfferingName             String
  snapshotDeliveryFormat           PartnershipDeliveryFormat
  snapshotTargetGrades             String?
  snapshotRecommendedLevel         PartnershipProgramLevel?
  snapshotDuration                 Int?
  snapshotDurationUnit             PartnershipDurationUnit?
  snapshotNumberOfSessions         Int?
  snapshotSessionDurationMinutes   Int?
  snapshotSessionFrequency         String?
  snapshotDeliveryMode             PartnershipDeliveryMode?
  snapshotGroupSizeMin             Int?
  snapshotGroupSizeMax             Int?
  snapshotNumberOfGroups           Int?
  snapshotShortDescription         String  @default("")
  snapshotSchoolValue              String  @default("")
  snapshotStudentValue             String  @default("")
  snapshotCurriculumJson           Json?
  snapshotProjectsJson             Json?
  snapshotOutcomesJson             Json?
  snapshotRequirementsJson         Json?
  snapshotAssessmentJson           Json?
  snapshotObjectivesJson           Json?
  snapshotActivitiesJson           Json?
  snapshotCapturedAt               DateTime @default(now())

  // --- Proposal-only customization (does not mutate Offering) ---
  customizedObjectives      String @default("")
  customizedCurriculumNotes String @default("")
  specialRequirements       String @default("")
  implementationNotes       String @default("")
  deliveryNotes             String @default("")

  // --- Line commercial pricing ---
  pricingModel    PartnershipPricingModel
  quantity        Decimal?                @db.Decimal(14, 4)
  unitPrice       Decimal?                @db.Decimal(14, 4)
  discountType    PartnershipDiscountType @default(NONE)
  discountValue   Decimal?                @db.Decimal(14, 4)
  lineSubtotal    Decimal?                @db.Decimal(14, 2)

  @@index([proposalId, sortOrder])
  @@index([offeringId])
}

model PartnershipProposalTimelinePhase {
  id          String              @id @default(uuid()) @db.Uuid
  proposalId  String              @db.Uuid
  proposal    PartnershipProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  title       String
  description String              @default("")
  sortOrder   Int                 @default(0)
  startDate   DateTime?
  endDate     DateTime?

