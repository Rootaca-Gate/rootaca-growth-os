model PartnershipDelivery {
  id            String                     @id @default(uuid()) @db.Uuid
  deliveryNumber String                    @unique
  name          String
  institutionId String                     @db.Uuid
  institution   PartnershipInstitution     @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  sowId         String                     @db.Uuid
  sow           PartnershipSow             @relation(fields: [sowId], references: [id], onDelete: Restrict)
  proposalId    String                     @db.Uuid
  proposal      PartnershipProposal        @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  status        PartnershipDeliveryStatus  @default(PREPARING)
  startDate     DateTime?
  endDate       DateTime?

  // Frozen execution snapshot from SOW at create (never mutates SOW)
  sowNumberSnapshot      String @default("")
  proposalNumberSnapshot String @default("")
  scopeSnapshot          Json?
  responsibilitiesSnapshot Json?
  requirementsSnapshot   Json?

  finalReportRequired Boolean @default(true)
  archivedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phases          PartnershipDeliveryPhase[]
  milestones      PartnershipDeliveryMilestone[]
  tasks           PartnershipDeliveryTask[]
  sessions        PartnershipDeliverySession[]
  groups          PartnershipDeliveryGroup[]
  teamMembers     PartnershipDeliveryTeamMember[]
  deliverables    PartnershipDeliveryDeliverable[]
  issues          PartnershipDeliveryIssue[]
  raidItems       PartnershipDeliveryRaidItem[]
  communications  PartnershipDeliveryCommunication[]
  checkpoints     PartnershipDeliveryCheckpoint[]
  reports         PartnershipDeliveryReport[]
  documents       PartnershipDeliveryDocument[]
  activityLogs    PartnershipDeliveryActivityLog[]
  partnershipReports PartnershipReport[]
  opportunitiesAsPrevious PartnershipOpportunity[] @relation("OpportunityPreviousDelivery")

  @@index([institutionId])
  @@index([sowId])
  @@index([proposalId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([createdAt])
  @@index([name])
}

model PartnershipDeliveryPhase {
  id          String                         @id @default(uuid()) @db.Uuid
  deliveryId  String                         @db.Uuid
  delivery    PartnershipDelivery            @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  name        String
  description String                         @default("")
  startDate   DateTime?
  endDate     DateTime?
  owner       String                         @default("")
  status      PartnershipDeliveryPhaseStatus @default(NOT_STARTED)
  sortOrder   Int                            @default(0)
  milestones  PartnershipDeliveryMilestone[]
  tasks       PartnershipDeliveryTask[]

  @@index([deliveryId, sortOrder])
}

model PartnershipDeliveryMilestone {
  id          String                             @id @default(uuid()) @db.Uuid
  deliveryId  String                             @db.Uuid
  delivery    PartnershipDelivery                @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  phaseId     String?                            @db.Uuid
  phase       PartnershipDeliveryPhase?          @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  sourceSowMilestoneId String?
  name        String
  description String                             @default("")
  startDate   DateTime?
  endDate     DateTime?
  owner       String                             @default("")
  status      PartnershipDeliveryMilestoneStatus @default(NOT_STARTED)
  requiredForCompletion Boolean                  @default(true)
  sortOrder   Int                                @default(0)
  tasks       PartnershipDeliveryTask[]

  @@index([deliveryId, sortOrder])
  @@index([phaseId])
}

model PartnershipDeliveryTask {
  id           String                           @id @default(uuid()) @db.Uuid
  deliveryId   String                           @db.Uuid
  delivery     PartnershipDelivery              @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  phaseId      String?                          @db.Uuid
  phase        PartnershipDeliveryPhase?        @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  milestoneId  String?                          @db.Uuid
  milestone    PartnershipDeliveryMilestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title        String
  description  String                           @default("")
  owner        String                           @default("")
  assigneeId   String?                          @db.Uuid
  assignee     User?                            @relation("DeliveryTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  priority     PartnershipDeliveryTaskPriority  @default(MEDIUM)
  startDate    DateTime?
  dueDate      DateTime?
  status       PartnershipDeliveryTaskStatus    @default(TO_DO)
  sortOrder    Int                              @default(0)
  createdAt    DateTime                         @default(now())
  updatedAt    DateTime                         @updatedAt

  @@index([deliveryId, sortOrder])
  @@index([assigneeId])
  @@index([status])
}

model PartnershipDeliveryGroup {
  id           String                         @id @default(uuid()) @db.Uuid
  deliveryId   String                         @db.Uuid
  delivery     PartnershipDelivery            @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  name         String
  grade        String                         @default("")
  level        String                         @default("")
  instructorId String?                        @db.Uuid
  schedule     String                         @default("")
  status       PartnershipDeliveryGroupStatus @default(PLANNED)
  sortOrder    Int                            @default(0)
  students     PartnershipDeliveryGroupStudent[]
  sessions     PartnershipDeliverySession[]

  @@index([deliveryId, sortOrder])
}

model PartnershipDeliveryGroupStudent {
  id        String                   @id @default(uuid()) @db.Uuid
  groupId   String                   @db.Uuid
  group     PartnershipDeliveryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String                   @db.Uuid
  student   Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  joinedAt  DateTime                 @default(now())

  @@unique([groupId, studentId])
  @@index([studentId])
}

model PartnershipDeliveryTeamMember {
  id             String              @id @default(uuid()) @db.Uuid
  deliveryId     String              @db.Uuid
  delivery       PartnershipDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  userId         String?             @db.Uuid
  user           User?               @relation("DeliveryTeamUser", fields: [userId], references: [id], onDelete: SetNull)
  role           String
  name           String              @default("")
  responsibilities String            @default("")
  availability   String              @default("")
  sortOrder      Int                 @default(0)

  @@index([deliveryId, sortOrder])
  @@index([userId])
}

model PartnershipDeliverySession {
  id              String                           @id @default(uuid()) @db.Uuid
  deliveryId      String                           @db.Uuid
  delivery        PartnershipDelivery              @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  groupId         String?                          @db.Uuid
  group           PartnershipDeliveryGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  sessionNumber   Int
  sessionDate     DateTime?
  startTime       String                           @default("")
  endTime         String                           @default("")
  durationMinutes Int?
  instructorId    String?                          @db.Uuid
  instructor      User?                            @relation("DeliverySessionInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  instructorName  String                           @default("")
  topic           String                           @default("")
  status          PartnershipDeliverySessionStatus @default(SCHEDULED)
  learningObjectives String                        @default("")
  activities      String                           @default("")
  projects        String                           @default("")
  homework        String                           @default("")
  instructorNotes String                           @default("")
  sessionOutcome  String                           @default("")
  issuesNotes     String                           @default("")
  nextSessionPrep String                           @default("")
  createdAt       DateTime                         @default(now())
  updatedAt       DateTime                         @updatedAt
  attendances     PartnershipDeliveryAttendance[]

  @@unique([deliveryId, sessionNumber])
  @@index([deliveryId, sessionDate])
  @@index([groupId])
  @@index([instructorId])
  @@index([status])
}

model PartnershipDeliveryAttendance {
  id        String                              @id @default(uuid()) @db.Uuid
  sessionId String                              @db.Uuid
  session   PartnershipDeliverySession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String                              @db.Uuid
  student   Student                             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  status    PartnershipDeliveryAttendanceStatus
  notes     String                              @default("")

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model PartnershipDeliveryDeliverable {
  id                 String                              @id @default(uuid()) @db.Uuid
  deliveryId         String                              @db.Uuid
  delivery           PartnershipDelivery                 @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
