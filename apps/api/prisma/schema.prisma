model PartnershipDeliveryDocument {
  id          String                            @id @default(uuid()) @db.Uuid
  deliveryId  String                            @db.Uuid
  delivery    PartnershipDelivery               @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  name        String
  type        PartnershipDeliveryDocumentType   @default(OTHER)
  version     String                            @default("1")
  uploadedBy  String                            @default("")
  fileUrl     String                            @default("")
  notes       String                            @default("")
  uploadedAt  DateTime                          @default(now())

  @@index([deliveryId, type])
}

model PartnershipDeliveryActivityLog {
  id          String              @id @default(uuid()) @db.Uuid
  deliveryId  String              @db.Uuid
  delivery    PartnershipDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  action      String
  summary     String              @default("")
  metadata    Json?
  performedById String?           @db.Uuid
  performedBy User?               @relation("DeliveryActivityActor", fields: [performedById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())

  @@index([deliveryId, createdAt])
  @@index([performedById])
}

// =============================================================================
// Partnership Reports (lifecycle ï¿½ Outcome Layer after Delivery)
// Aggregates Delivery execution data. Never mutates Program/Offering/Proposal/SOW/Delivery.
// Distinct from PartnershipDeliveryReport (operational artifacts attached to a delivery).
// =============================================================================

enum PartnershipReportType {
  STUDENT_PROGRESS
  GROUP_PROGRESS
  SCHOOL_SUMMARY
  PROGRAM_COMPLETION
  FINAL_PARTNERSHIP
}

enum PartnershipReportStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum PartnershipReportRecommendationPriority {
  LOW
  MEDIUM
  HIGH
}

/// Student progress row status ï¿½ computed from measurable delivery data only.
enum PartnershipReportStudentTrackStatus {
  ON_TRACK
  NEEDS_ATTENTION
  COMPLETED
  NOT_ASSESSED
}

model PartnershipReport {
  id           String                    @id @default(uuid()) @db.Uuid
  reportNumber String                    @unique
  title        String
  type         PartnershipReportType
  status       PartnershipReportStatus   @default(DRAFT)
  version      String                    @default("1.0")

  institutionId String                 @db.Uuid
  institution   PartnershipInstitution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  deliveryId    String                 @db.Uuid
  delivery      PartnershipDelivery    @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  sowId         String                 @db.Uuid
  sow           PartnershipSow         @relation(fields: [sowId], references: [id], onDelete: Restrict)
  proposalId    String                 @db.Uuid
  proposal      PartnershipProposal    @relation(fields: [proposalId], references: [id], onDelete: Restrict)

  // Frozen identity labels (never invent)
  institutionNameSnapshot String @default("")
  deliveryNumberSnapshot  String @default("")
  sowNumberSnapshot       String @default("")
  proposalNumberSnapshot  String @default("")
  programNameSnapshot     String @default("")

  periodStart DateTime?
  periodEnd   DateTime?
  periodLabel String @default("")
  preparedBy  String @default("")

  // Editable narrative (manual ï¿½ not invented)
  executiveSummary String @default("")
  achievements     String @default("")
  nextSteps        String @default("")
  renewalNotes     String @default("")
  internalNotes    String @default("")

  /// Working / published aggregate bundle (KPIs, students, groups, etc.)
  dataSnapshot Json?
  /// Immutable school-facing subset frozen at Publish
  publishedSnapshot Json?
  publishedAt       DateTime?
  publishedById     String?   @db.Uuid
  publishedBy       User?     @relation("PartnershipReportPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  archivedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recommendations PartnershipReportRecommendation[]
  versions        PartnershipReportVersion[]
  activityLogs    PartnershipReportActivityLog[]
  opportunitiesAsPrevious PartnershipOpportunity[] @relation("OpportunityPreviousReport")

  @@index([institutionId])
  @@index([deliveryId])
  @@index([sowId])
  @@index([proposalId])
  @@index([type])
  @@index([status])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([createdAt])
  @@index([title])
}

model PartnershipReportRecommendation {
  id          String                                  @id @default(uuid()) @db.Uuid
  reportId    String                                  @db.Uuid
  report      PartnershipReport                       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  text        String                                  @default("")
  priority    PartnershipReportRecommendationPriority @default(MEDIUM)
  owner       String                                  @default("")
  targetDate  DateTime?
  /// When true, excluded from school-facing PDF / snapshot
  isInternal  Boolean                                 @default(false)
  sortOrder   Int                                     @default(0)
  createdAt   DateTime                                @default(now())
  updatedAt   DateTime                                @updatedAt

  @@index([reportId, sortOrder])
}

model PartnershipReportVersion {
  id              String            @id @default(uuid()) @db.Uuid
  reportId        String            @db.Uuid
  report          PartnershipReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  version         String
  changeNote      String            @default("")
  snapshot        Json
  publishedSnapshot Json?
  createdById     String?           @db.Uuid
  createdBy       User?             @relation("PartnershipReportVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())

  @@index([reportId, createdAt])
  @@index([createdById])
}

model PartnershipReportActivityLog {
  id            String            @id @default(uuid()) @db.Uuid
  reportId      String            @db.Uuid
  report        PartnershipReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  action        String
  summary       String            @default("")
  metadata      Json?
  performedById String?           @db.Uuid
  performedBy   User?             @relation("PartnershipReportActivityActor", fields: [performedById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())

  @@index([reportId, createdAt])
  @@index([performedById])
}

enum PartnershipOpportunityType {
  RENEWAL
  EXPANSION
  RENEWAL_AND_EXPANSION
}

enum PartnershipOpportunityStatus {
  IDENTIFIED
  PLANNING
  PROPOSAL_DRAFT
  PROPOSAL_SENT
  NEGOTIATION
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  CLOSED
}

enum PartnershipOpportunityExpansionKind {
  NEW_PROGRAM
  MORE_STUDENTS
  MORE_GROUPS
  NEW_GRADES
  NEW_CAMPUS
  NEW_DELIVERY_FORMAT
  EXTENDED_DURATION
  CUSTOMIZED_PROGRAM
}

enum PartnershipOpportunityTimelineKind {
  OPPORTUNITY_CREATED
  PREVIOUS_REPORT_REVIEWED
  SCHOOL_CONTACTED
  MEETING
  REQUIREMENT_RECEIVED
  PROPOSAL_CREATED
  PROPOSAL_SENT
  NEGOTIATION
  ACCEPTED
  REJECTED
  CONVERTED
  CLOSED
  CUSTOM
}

model PartnershipOpportunity {
  id                String                       @id @default(uuid()) @db.Uuid
  opportunityNumber String                       @unique
  title             String
  type              PartnershipOpportunityType
  status            PartnershipOpportunityStatus @default(IDENTIFIED)

  institutionId       String                 @db.Uuid
  institution         PartnershipInstitution @relation("OpportunityInstitution", fields: [institutionId], references: [id], onDelete: Restrict)
  campusInstitutionId String?                @db.Uuid
  campusInstitution   PartnershipInstitution? @relation("OpportunityCampus", fields: [campusInstitutionId], references: [id], onDelete: SetNull)

  previousProposalId String?             @db.Uuid
  previousProposal   PartnershipProposal? @relation("OpportunityPreviousProposal", fields: [previousProposalId], references: [id], onDelete: SetNull)
  previousSowId      String?             @db.Uuid
  previousSow        PartnershipSow?      @relation("OpportunityPreviousSow", fields: [previousSowId], references: [id], onDelete: SetNull)
  previousDeliveryId String?             @db.Uuid
  previousDelivery   PartnershipDelivery? @relation("OpportunityPreviousDelivery", fields: [previousDeliveryId], references: [id], onDelete: SetNull)
  previousReportId   String?             @db.Uuid
  previousReport     PartnershipReport?   @relation("OpportunityPreviousReport", fields: [previousReportId], references: [id], onDelete: SetNull)

  newProposalId String?             @db.Uuid
  newProposal   PartnershipProposal? @relation("OpportunityNewProposal", fields: [newProposalId], references: [id], onDelete: SetNull)
  newSowId      String?             @db.Uuid
  newSow        PartnershipSow?      @relation("OpportunityNewSow", fields: [newSowId], references: [id], onDelete: SetNull)

  ownerId String? @db.Uuid
  owner   User?   @relation("PartnershipOpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  expectedDate       DateTime?
  historicalSnapshot Json?
  renewalProgramIds  Json?
  renewalOfferingIds Json?

  renewalGrades       String @default("")
  renewalGroupsNote   String @default("")
  renewalDurationNote String @default("")
  renewalDeliveryMode String @default("")
  renewalScopeNotes   String @default("")
  expansionScopeNotes String @default("")
  proposedScopeNotes  String @default("")
  existingScopeNotes  String @default("")

  reason           String @default("")
  schoolFeedback   String @default("")
  successFactors   String @default("")
  challenges       String @default("")
  requestedChanges String @default("")
  internalNotes    String @default("")
  nextSteps        String @default("")

  feedbackSummary           String   @default("")
  feedbackScore             Decimal? @db.Decimal(4, 2)
  feedbackRequestedPrograms String   @default("")
  feedbackRequestedChanges  String   @default("")
  feedbackKeyComments       String   @default("")
  feedbackDate              DateTime?
  feedbackRecordedBy        String   @default("")

  archivedAt  DateTime?
  convertedAt DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  expansionKinds PartnershipOpportunityExpansionType[]
  timeline       PartnershipOpportunityTimelineEvent[]
  activityLogs   PartnershipOpportunityActivityLog[]

  @@index([institutionId])
  @@index([campusInstitutionId])
  @@index([previousProposalId])
  @@index([previousSowId])
  @@index([previousDeliveryId])
  @@index([previousReportId])
  @@index([newProposalId])
  @@index([newSowId])
  @@index([ownerId])
  @@index([type])
  @@index([status])
  @@index([expectedDate])
  @@index([createdAt])
  @@index([title])
}

model PartnershipOpportunityExpansionType {
  id            String                              @id @default(uuid()) @db.Uuid
  opportunityId String                              @db.Uuid
  opportunity   PartnershipOpportunity              @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  kind          PartnershipOpportunityExpansionKind
  notes         String                              @default("")
  sortOrder     Int                                 @default(0)

  @@unique([opportunityId, kind])
  @@index([opportunityId, sortOrder])
}

model PartnershipOpportunityTimelineEvent {
  id            String                             @id @default(uuid()) @db.Uuid
  opportunityId String                             @db.Uuid
  opportunity   PartnershipOpportunity             @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  kind          PartnershipOpportunityTimelineKind
  occurredAt    DateTime                           @default(now())
  note          String                             @default("")
  performedById String?                            @db.Uuid
  performedBy   User?                              @relation("PartnershipOpportunityTimelineActor", fields: [performedById], references: [id], onDelete: SetNull)
  createdAt     DateTime                           @default(now())

  @@index([opportunityId, occurredAt])
  @@index([performedById])
}

model PartnershipOpportunityActivityLog {
  id            String                 @id @default(uuid()) @db.Uuid
  opportunityId String                 @db.Uuid
  opportunity   PartnershipOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  action        String
  summary       String                 @default("")
  metadata      Json?
  performedById String?                @db.Uuid
  performedBy   User?                  @relation("PartnershipOpportunityActivityActor", fields: [performedById], references: [id], onDelete: SetNull)
  createdAt     DateTime               @default(now())

  @@index([opportunityId, createdAt])
  @@index([performedById])
}
