# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:4200,https://rootaca-admin.web.app,https://rootaca-admin.firebaseapp.com

# Neon PostgreSQL
# DATABASE_URL = pooled connection (app queries)
# DIRECT_URL   = unpooled connection (Prisma migrate)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info

# Partnership Research Engine — Overpass (FREE) + optional Serper WEB_SEARCH
# Backend-only. Never expose RESEARCH_DISCOVERY_API_KEY or Overpass config to Angular.
# RESEARCH_DISCOVERY_PROVIDER: OVERPASS | WEB_SEARCH | HYBRID | MANUAL | NONE
RESEARCH_DISCOVERY_PROVIDER=HYBRID
RESEARCH_DISCOVERY_ENGINE=serper
RESEARCH_DISCOVERY_API_KEY=
RESEARCH_DISCOVERY_API_URL=https://google.serper.dev/search
# Optional Brave Search: RESEARCH_DISCOVERY_ENGINE=brave
# RESEARCH_DISCOVERY_API_URL=https://api.search.brave.com/res/v1/web/search
RESEARCH_DISCOVERY_TIMEOUT_MS=15000
RESEARCH_DISCOVERY_MAX_RETRIES=2
RESEARCH_DISCOVERY_CONCURRENCY=2
RESEARCH_DISCOVERY_REQUEST_DELAY_MS=250
RESEARCH_DISCOVERY_CACHE_TTL_MS=900000
# OpenStreetMap / Overpass — FREE structured school discovery (no API key)
RESEARCH_OVERPASS_ENABLED=true
RESEARCH_OVERPASS_API_URL=https://overpass-api.de/api/interpreter
RESEARCH_OVERPASS_USER_AGENT=ROOTACA-Research/1.0 (+https://rootaca.com)
RESEARCH_OVERPASS_TIMEOUT_MS=30000
RESEARCH_OVERPASS_MAX_RESULTS=1000
RESEARCH_OVERPASS_CONCURRENCY=1
RESEARCH_OVERPASS_MAX_RETRIES=2
RESEARCH_OVERPASS_REQUEST_DELAY_MS=1500
RESEARCH_OVERPASS_CACHE_TTL_MS=1800000
# Optional public-page enrichment (SSRF-safe, rate-limited). Default off.
RESEARCH_ENRICHMENT_ENABLED=true
RESEARCH_ENRICHMENT_MAX_PAGES=4
RESEARCH_ENRICHMENT_MAX_BYTES=300000
RESEARCH_ENRICHMENT_TIMEOUT_MS=10000
