  acceptanceCriteria String                              @default("")
  status             PartnershipDeliveryDeliverableStatus @default(NOT_STARTED)
  requiredForCompletion Boolean                          @default(true)
  rejectionReason    String                              @default("")
  sortOrder          Int                                 @default(0)
