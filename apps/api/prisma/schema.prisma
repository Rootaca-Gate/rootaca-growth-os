  createdAt     DateTime                @default(now())

  @@index([institutionId])
  @@index([leadId])
  @@index([contactId])
  @@index([activityDate])
  @@index([activityType])
  @@index([createdById])
  @@index([createdAt])
}

model PartnershipFollowUp {
  id            String                      @id @default(uuid()) @db.Uuid
  institutionId String                      @db.Uuid
  institution   PartnershipInstitution      @relation(fields: [institutionId], references: [id], onDelete: Restrict)
