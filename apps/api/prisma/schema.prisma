  note        String              @default("")
  createdAt   DateTime            @default(now())

  @@index([proposalId, createdAt])
}

// =============================================================================
// PartnershipSow â Statement of Work (execution agreement after approved Proposal)
// Program = what we offer | Offering = how we deliver | Proposal = commercial offer
// SOW = what was agreed and how it will be executed. Do not mix layers.
// Pricing is NEVER recalculated here â commercial reference only from Proposal.
// =============================================================================

enum PartnershipSowStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PartnershipSowDeliverableStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ACCEPTED
}

enum PartnershipSowMilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
  CANCELLED
}

enum PartnershipSowScopeKind {
  IN_SCOPE
  OUT_OF_SCOPE
}

enum PartnershipSowParty {
  ROOTACA
  SCHOOL
}

enum PartnershipSowChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PartnershipSowChangeImpact {
  MINOR
  MAJOR
}

model PartnershipSow {
  id            String                 @id @default(uuid()) @db.Uuid
  sowNumber     String                 @unique
  title         String
  institutionId String                 @db.Uuid
  institution   PartnershipInstitution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  proposalId    String                 @db.Uuid
  proposal      PartnershipProposal    @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  status        PartnershipSowStatus   @default(DRAFT)
  sowDate       DateTime               @default(now())
  effectiveDate DateTime?
  startDate     DateTime?
  endDate       DateTime?
  version       String                 @default("1.0")
  preparedBy    String                 @default("")
  approvedBy    String                 @default("")

  purpose String @default("")

  // Scope narrative (editable; offerings come from proposal snapshots)
  targetStudents      String @default("")
  deliveryModelNotes  String @default("")
  activitiesNotes     String @default("")
  projectsNotes       String @default("")
  assessmentNotes     String @default("")
  reportingNotes      String @default("")

  // Parties â copied from institution/proposal at create; never invent
  clientName          String @default("")
  clientAddress       String @default("")
  primaryContactName  String @default("")
  primaryContactEmail String @default("")
  primaryContactPhone String @default("")

  // Attendance & participation (optional / configurable)
  attendanceExpectations  String @default("")
  minimumParticipation    String @default("")
  studentReplacementRules String @default("")
  makeupSessionRules      String @default("")

  // Delivery requirements (seeded from offering snapshots; editable on SOW)
  equipmentRequirements       String @default("")
  internetRequirements        String @default("")
  classroomLabRequirements    String @default("")
  studentDevicesRequirements  String @default("")
  softwareRequirements        String @default("")
  accountsAccessRequirements  String @default("")
  facultyLiaisonRequirements  String @default("")

  // Terms (configurable template content â not invented legal wording)
  termsAndConditions String @default("")

  // Commercial reference snapshot from Proposal (display only â no recalculation)
  proposalNumberSnapshot String  @default("")
  agreedValueSnapshot    Decimal? @db.Decimal(14, 2)
  currencySnapshot       String?
  paymentTermsSnapshot   String  @default("")

  // Signatures (no fake / legally-binding claims)
  rootacaSignatoryName    String    @default("")
  rootacaSignatoryTitle   String    @default("")
  rootacaSignedAt         DateTime?
  rootacaSignatureImage   String    @default("")
  schoolSignatoryName     String    @default("")
  schoolSignatoryTitle    String    @default("")
  schoolSignedAt          DateTime?
  schoolSignatureImage    String    @default("")

  isLocked          Boolean   @default(false)
  documentSnapshot  Json?
  archivedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scopeOfferings   PartnershipSowScopeOffering[]
  scopeItems       PartnershipSowScopeItem[]
  deliverables     PartnershipSowDeliverable[]
  milestones       PartnershipSowMilestone[]
  responsibilities PartnershipSowResponsibility[]
  teamMembers      PartnershipSowTeamMember[]
  assessmentItems  PartnershipSowAssessmentItem[]
  changeRequests   PartnershipSowChangeRequest[]
  versions         PartnershipSowVersion[]
  deliveries       PartnershipDelivery[]
  partnershipReports PartnershipReport[]
  opportunitiesAsPrevious PartnershipOpportunity[] @relation("OpportunityPreviousSow")
  opportunitiesAsNewSow   PartnershipOpportunity[] @relation("OpportunityNewSow")

  @@index([institutionId])
  @@index([proposalId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([createdAt])
  @@index([title])
}

